PORT=5000
# comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:5173,https://manukrishnan1305.netlify.app
# https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
# any model ID from https://openrouter.ai/models — avoid the "openrouter/free"
# alias, it randomly load-balances across ALL free models including reasoning
# models and a content-moderation classifier, both unsuitable for real replies
OPENROUTER_MODEL=nvidia/nemotron-nano-9b-v2:free
# AI Image Studio (POST /api/vision/stream) — comma-separated, each must accept
# image input; first is primary, the rest are fallbacks when it's rate-limited
OPENROUTER_VISION_MODEL=google/gemma-4-31b-it:free,nvidia/nemotron-3.5-super-vl:free,google/gemma-4-26b-a4b-it:free
# optional, shown on OpenRouter's dashboard/rankings for your app
SITE_URL=http://:5173
SITE_NAME=Portfolio
# MongoDB Atlas connection string (see db.rd for the cluster host — fill in the real password here, not there)
MONGODB_URI=mongodb://<user>:<password>@<cluster-host>/portfolio?ssl=true&replicaSet=<name>&authSource=admin&appName=<app>
# protects GET /api/contacts — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=
# bootstrap only — creates the first admin user in the DB on first startup if
# the users collection is empty; ignored after that (change your password via
# PATCH /api/auth/password instead of editing these)
ADMIN_USERNAME=
# never store the plain password — generate with: node -e "console.log(require('bcryptjs').hashSync('yourpassword', 10))"
ADMIN_PASSWORD_HASH=
# signs login tokens — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# https://imagekit.io/dashboard/developer/api-keys — used for profile avatar uploads
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
# https://console.cloud.google.com/apis/credentials — OAuth 2.0 Client ID (Web
# application). Used to verify member sign-in tokens. Not secret — the
# frontend needs this same value to initialize the Google Sign-In button.
GOOGLE_CLIENT_ID=
# YouTube downloader — YouTube bot-checks datacenter IPs (Render included).
# Export cookies.txt (Netscape format) from a browser logged into a throwaway
# Google account, then EITHER paste its contents here (literal \n is accepted
# for newlines) OR point YTDLP_COOKIES_FILE at the file (e.g. a Render Secret
# File at /etc/secrets/yt-cookies.txt). Re-export when downloads start failing.
# YTDLP_COOKIES=
# YTDLP_COOKIES_FILE=
