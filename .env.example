PORT=5000
# comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:5173,https://manukrishnan1305.netlify.app
# https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
# any model ID from https://openrouter.ai/models
OPENROUTER_MODEL=openrouter/free
# optional, shown on OpenRouter's dashboard/rankings for your app
SITE_URL=http://localhost:5173
SITE_NAME=Portfolio
# MongoDB Atlas connection string (see db.rd for the cluster host — fill in the real password here, not there)
MONGODB_URI=mongodb://<user>:<password>@<cluster-host>/portfolio?ssl=true&replicaSet=<name>&authSource=admin&appName=<app>
# protects GET /api/contacts — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=
# bootstrap only — creates the first admin user in the DB on first startup if
# the users collection is empty; ignored after that (change your password via
# PATCH /api/auth/password instead of editing these)
ADMIN_USERNAME=
# never store the plain password — generate with: node -e "console.log(require('bcryptjs').hashSync('yourpassword', 10))"
ADMIN_PASSWORD_HASH=
# signs login tokens — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
